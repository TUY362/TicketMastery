<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kt.controller.EventoController"
      spacing="16">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Administración de eventos"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <GridPane hgap="12" vgap="12">

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
        </columnConstraints>

        <Label text="Nombre:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Nombre del evento"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Lugar:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtLugar"
                   promptText="Lugar del evento"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Fecha (UTC):"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <DatePicker fx:id="dpFecha"
                    editable="false"
                    maxWidth="Infinity"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2"/>

        <Label text="Hora (UTC):"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="txtHora"
                   promptText="HH:mm, por ejemplo 18:30"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <CheckBox fx:id="chkActivo"
                  text="Evento activo"
                  selected="true"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>

    </GridPane>

    <FlowPane hgap="10" vgap="10">

        <Button fx:id="btnGuardar"
                text="Guardar"
                onAction="#guardar"
                style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

        <Button fx:id="btnActualizar"
                text="Actualizar"
                onAction="#actualizar"
                disable="true"/>

        <Button fx:id="btnEliminar"
                text="Eliminar"
                onAction="#eliminar"
                disable="true"
                style="-fx-background-color: #b91c1c; -fx-text-fill: white;"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#limpiar"/>

        <Button fx:id="btnRecargar"
                text="Recargar"
                onAction="#recargar"/>

    </FlowPane>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-text-fill: #b91c1c;"/>

    <TableView fx:id="tablaEventos"
               prefHeight="280"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay eventos para mostrar."/>
        </placeholder>

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="55"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="180"/>

            <TableColumn fx:id="colFechaHora"
                         text="Fecha y hora (UTC)"
                         prefWidth="165"/>

            <TableColumn fx:id="colLugar"
                         text="Lugar"
                         prefWidth="160"/>

            <TableColumn fx:id="colActivo"
                         text="Activo"
                         prefWidth="75"/>

        </columns>

    </TableView>

</VBox>