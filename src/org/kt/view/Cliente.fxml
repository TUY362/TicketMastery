<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kt.controller.ClienteController"
      spacing="16">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Administración de clientes"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <GridPane hgap="12" vgap="12">

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
        </columnConstraints>

        <Label text="Nombre:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Nombre completo"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Correo:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtCorreo"
                   promptText="Por ejemplo: cliente@correo.com"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Teléfono:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtTelefono"
                   promptText="Opcional"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

    </GridPane>

    <FlowPane hgap="10" vgap="10">

        <Button fx:id="btnGuardar"
                text="Guardar"
                onAction="#guardar"
                style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

        <Button fx:id="btnActualizar"
                text="Actualizar"
                onAction="#actualizar"
                disable="true"/>

        <Button fx:id="btnEliminar"
                text="Eliminar"
                onAction="#eliminar"
                disable="true"
                style="-fx-background-color: #b91c1c; -fx-text-fill: white;"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#limpiar"/>

        <Button fx:id="btnRecargar"
                text="Recargar"
                onAction="#recargar"/>

    </FlowPane>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-text-fill: #b91c1c;"/>

    <TableView fx:id="tablaClientes"
               prefHeight="300"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay clientes para mostrar."/>
        </placeholder>

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="220"/>

            <TableColumn fx:id="colCorreo"
                         text="Correo"
                         prefWidth="230"/>

            <TableColumn fx:id="colTelefono"
                         text="Teléfono"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>