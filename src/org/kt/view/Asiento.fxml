<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kt.controller.AsientoController"
      spacing="16">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Administración de asientos"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <GridPane hgap="12" vgap="12">

        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
        </columnConstraints>

        <Label text="Zona:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <ComboBox fx:id="cmbZona"
                  promptText="Selecciona una zona"
                  maxWidth="Infinity"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>

        <Label text="Fila:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtFila"
                   promptText="Por ejemplo: A"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Número:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtNumero"
                   promptText="Por ejemplo: 10"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

    </GridPane>

    <FlowPane hgap="10" vgap="10">

        <Button fx:id="btnGuardar"
                text="Guardar"
                onAction="#guardar"
                style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

        <Button fx:id="btnActualizar"
                text="Actualizar"
                onAction="#actualizar"
                disable="true"/>

        <Button fx:id="btnEliminar"
                text="Eliminar"
                onAction="#eliminar"
                disable="true"
                style="-fx-background-color: #b91c1c; -fx-text-fill: white;"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#limpiar"/>

        <Button fx:id="btnRecargar"
                text="Recargar"
                onAction="#recargar"/>

    </FlowPane>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-text-fill: #b91c1c;"/>

    <TableView fx:id="tablaAsientos"
               prefHeight="300"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay asientos para mostrar."/>
        </placeholder>

        <columns>

            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60"/>

            <TableColumn fx:id="colZona"
                         text="Evento / Zona"
                         prefWidth="260"/>

            <TableColumn fx:id="colFila"
                         text="Fila"
                         prefWidth="90"/>

            <TableColumn fx:id="colNumero"
                         text="Número"
                         prefWidth="90"/>

            <TableColumn fx:id="colReservaHasta"
                         text="Reserva hasta (UTC)"
                         prefWidth="180"/>

        </columns>

    </TableView>

</VBox>