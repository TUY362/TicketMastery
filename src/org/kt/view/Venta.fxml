<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.kt.controller.VentaController"
            fitToWidth="true">

    <content>
        <VBox spacing="16">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Venta de boletos"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

            <Label fx:id="lblTaquillero"
                   text=""
                   style="-fx-text-fill: #475569;"/>

            <GridPane hgap="12" vgap="12">

                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                </columnConstraints>

                <Label text="Cliente:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="cmbCliente"
                          promptText="Selecciona un cliente"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Evento:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="cmbEvento"
                          promptText="Selecciona un evento"
                          onAction="#seleccionarEvento"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Zona:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="cmbZona"
                          promptText="Selecciona una zona"
                          onAction="#seleccionarZona"
                          maxWidth="Infinity"
                          disable="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Asiento:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <ComboBox fx:id="cmbAsiento"
                          promptText="Selecciona un asiento"
                          maxWidth="Infinity"
                          disable="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Precio:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <Label fx:id="lblPrecio"
                       text="Q 0.00"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="4"/>

            </GridPane>

            <FlowPane hgap="10" vgap="10">

                <Button fx:id="btnReservar"
                        text="Reservar asiento"
                        onAction="#reservar"
                        disable="true"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>

                <Button fx:id="btnCancelar"
                        text="Cancelar reserva"
                        onAction="#cancelar"
                        disable="true"/>

                <Button fx:id="btnRecargar"
                        text="Recargar disponibilidad"
                        onAction="#recargar"/>

            </FlowPane>

            <Label fx:id="lblReserva"
                   text="Sin reserva activa"
                   wrapText="true"
                   style="-fx-font-weight: bold; -fx-text-fill: #92400e;"/>

            <Label text="El asiento se reserva durante 3 minutos. Confirma el pago antes de que venza."
                   wrapText="true"/>

            <GridPane hgap="12" vgap="12">

                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                </columnConstraints>

                <Label text="Referencia de pago:"
                       wrapText="true"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtReferencia"
                           promptText="Referencia única del pago recibido"
                           disable="true"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

            </GridPane>

            <CheckBox fx:id="chkPagoConfirmado"
                      text="Confirmo que el pago fue recibido"
                      disable="true"/>

            <Button fx:id="btnConfirmar"
                    text="Confirmar pago y emitir boleto"
                    onAction="#confirmar"
                    disable="true"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #15803d; -fx-text-fill: white;"/>

            <Label fx:id="lblMensaje"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #b91c1c;"/>

            <VBox fx:id="panelBoleto"
                  spacing="10"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: white; -fx-border-color: #cbd5e1;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Boleto emitido"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <Label fx:id="lblDetalleBoleto"
                       text=""
                       wrapText="true"/>

                <Label text="Código del boleto:"/>

                <TextField fx:id="txtCodigoBoleto"
                           editable="false"/>

                <ImageView fx:id="imgQR"
                           fitWidth="256"
                           fitHeight="256"
                           preserveRatio="true"
                           smooth="false"/>

                <Button fx:id="btnNuevaVenta"
                        text="Nueva venta"
                        onAction="#nuevaVenta"/>

            </VBox>

        </VBox>
    </content>

</ScrollPane>