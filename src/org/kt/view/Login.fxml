<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kt.controller.LoginController"
      alignment="CENTER"
      spacing="16"
      prefWidth="480"
      prefHeight="500"
      style="-fx-background-color: #f1f5f9;">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="TicketMastery"
           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <Label text="Ingresa con tu cuenta"
           style="-fx-font-size: 15px; -fx-text-fill: #475569;"/>

    <VBox spacing="8">
        <Label text="Usuario"/>
        <TextField fx:id="txtUsuario"
                   promptText="Escribe tu usuario"
                   prefHeight="40"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Contraseña"/>
        <PasswordField fx:id="txtPassword"
                       promptText="Escribe tu contraseña"
                       prefHeight="40"/>
    </VBox>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           maxWidth="Infinity"
           style="-fx-text-fill: #b91c1c;"/>

    <Button fx:id="btnIngresar"
            text="Iniciar sesión"
            onAction="#iniciarSesion"
            defaultButton="true"
            maxWidth="Infinity"
            prefHeight="42"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-cursor: hand;"/>

</VBox>