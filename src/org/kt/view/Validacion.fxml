<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kt.controller.ValidacionController"
      spacing="18">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Validación de boletos"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <Label fx:id="lblValidador"
           text=""
           style="-fx-text-fill: #475569;"/>

    <Label text="Escanea el código con un lector que escriba como teclado, o pega el código del boleto."
           wrapText="true"/>

    <TextField fx:id="txtCodigo"
               promptText="Código del boleto"
               onAction="#validar"
               prefHeight="42"/>

    <FlowPane hgap="10" vgap="10">

        <Button fx:id="btnValidar"
                text="Validar entrada"
                onAction="#validar"
                prefHeight="40"
                style="-fx-background-color: #15803d; -fx-text-fill: white;"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"
                onAction="#limpiar"
                prefHeight="40"/>

    </FlowPane>

    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

    <VBox fx:id="panelResultado"
          spacing="12"
          visible="false"
          managed="false"
          style="-fx-background-color: white; -fx-border-color: #cbd5e1;">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Entrada validada"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>

        <Label fx:id="lblDetalle"
               text=""
               wrapText="true"/>

    </VBox>

</VBox>